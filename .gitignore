# ============================================
# Fichiers système macOS/Windows
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# Données sensibles et fichiers temporaires
# ============================================
# Les motifs sont volontairement redondants : une instance peut être
# installée à la racine (site/file/...) ou dans un sous-dossier
# (site/site/file/...). Les motifs ancrés type "site/file/*" ne
# couvraient pas le second cas, ce qui a fait entrer des sauvegardes
# de plusieurs centaines de Mo dans l'historique Git.
site/data/**
site/tmp/**
site/backup/**
site/file/**
site/**/data/**
site/**/tmp/**
site/**/backup/**
site/**/file/**
# Seule exception : le .htaccess de protection de site/i18n (versionné)
!site/i18n/.htaccess
# Archives de sauvegarde : ne doivent jamais être versionnées
*.zip
*.ZIP
core/module/config/tool/data.key

# ============================================
# Fichiers générés automatiquement
# ============================================
robots.txt
llms.txt
sitemap*.xml
core/vendor/tinymce/link_list.json

# ============================================
# Internationalisation (fichiers générés)
# ============================================
site/i18n/*.json

# ============================================
# Développement et IDE
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.env
.env.local
.env.*.local

# ============================================
# Logs et cache
# ============================================
*.log
logs/
.cache/
*.cache

# ============================================
# Dépendances (Node.js, Composer)
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
composer.lock

# ============================================
# Fichiers Git (déjà gérés par Git)
# ============================================
.git
.gitignore
llms.txt
